# Đồng bộ đa thiết bị (tùy chọn, Mục 13 URD). Sao chép file này thành .env.local rồi
# điền giá trị lấy từ Firebase Console — xem hướng dẫn từng bước trong README.md.
# Không cấu hình thì ứng dụng vẫn hoạt động bình thường, chỉ không có tính năng đồng bộ.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
