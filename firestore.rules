rules_version = '2';

// Đồng bộ đa thiết bị (Mục 13 URD). Mỗi document = 1 mã đồng bộ, mã vừa là khóa tra
// cứu vừa đóng vai trò mật khẩu (SY-04) — chỉ yêu cầu đã đăng nhập ẩn danh (Anonymous
// Auth, SY-05) để chặn truy cập hoàn toàn không xác thực. Không xây hệ thống tài khoản
// thật vì ứng dụng chỉ dùng ở quy mô gia đình (1-2 học sinh).
service cloud.firestore {
  match /databases/{database}/documents {
    match /progress_sync/{syncCode} {
      allow read, write: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
